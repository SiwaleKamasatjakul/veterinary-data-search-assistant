{
    "general_setting": {
        "host": "127.0.0.1",
        "port": 8000
    },
    "paths": {
        "log_file_path": "logs"
    },
    "retrieval": {
        "backend": "tfidf",
        "embedding_model": "text-embedding-3-small",
        "top_k": 2,
        "min_similarity": {
            "tfidf": 0.19,
            "openai": 0.35
        }
    },
    "DB_NAME": "data/vet_doc.db",
    "CHAT_HISTORY_DB": "data/chat_history.db",
    "EMBEDDING_CACHE": "data/embedding_cache.db",
    "FAISS_INDEX_FILE": "src/vectordb/vet_doc.index",
    "EMBEDDER_FILE": "src/vectordb/vet_doc_embedder.joblib",
    "INDEX_META_FILE": "src/vectordb/index_meta.json",
    "backend": "openai"
}
