# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# Leave OPENAI_API_KEY empty to run offline with a stub LLM: retrieval and the
# response contract stay fully testable, no cost, no key.
OPENAI_API_KEY=

# Force the stub even when a key is present (handy for tests).
USE_MOCK_LLM=

# Optional: point at a different config file.
# CHATBOT_CONFIG=/absolute/path/to/llm_config.json
